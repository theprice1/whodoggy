# Root-level environment config (used by scripts/tools)

# PostgreSQL root connection string (used by seed/migrate scripts)
DATABASE_URL=postgresql://postgres:password@localhost:5432/whodoggy

# Firebase Admin SDK service account (JSON string or path to key file)
FIREBASE_ADMIN_SDK_JSON_PATH=./secrets/firebase-adminsdk.json

# Set to "true" to enable verbose logging for all scripts
VERBOSE_LOGGING=true
