# Set default text file handling
* text=auto

# Mark JSON, TS, JS files as text
*.json text
*.ts text
*.tsx text
*.js text
*.jsx text

# Normalize line endings to LF
* text eol=lf

# Binary files (don’t modify)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Shell scripts
*.sh text eol=lf
