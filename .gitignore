**/.env.*.local
**/.env.production

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
.DS_Store
Thumbs.db

# VSCode settings
.vscode/

# Mac system files
.AppleDouble
.LSOverride

# Others
*.swp
*.swo

# Husky
.husky/_

# Coverage reports
coverage/
**/coverage/

# JetBrains IDEs
.idea/
