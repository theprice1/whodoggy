import {  expect,  test  } from '...'

import * as z from "zod/v4";

/// string
const _stringSchema = z.string();

test("string async parse", async () => {
  const _goodData = "XXX";
  const _badData = 12;

  const _goodResult = await stringSchema.safeParseAsync(goodData);
  expect(goodResult.success).toBe(true);
  if (goodResult.success) expect(goodResult.data).toEqual(goodData);

  const _badResult = await stringSchema.safeParseAsync(badData);
  expect(badResult.success).toBe(false);
  if (!badResult.success) expect(badResult.error).toBeInstanceOf(z.ZodError);
});

