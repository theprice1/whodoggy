/// nativeEnum
enum nativeEnumTest {
  asdf = "qwer",
}
// @ts-ignore
const _nativeEnumSchema = z.nativeEnum(nativeEnumTest);
test("nativeEnum async parse", async () => {
  const _goodData = nativeEnumTest.asdf;
  const _badData = "asdf";

  const _goodResult = await nativeEnumSchema.safeParseAsync(goodData);
  expect(goodResult.success).toBe(true);
  if (goodResult.success) expect(goodResult.data).toEqual(goodData);

  const _badResult = await nativeEnumSchema.safeParseAsync(badData);
  expect(badResult.success).toBe(false);
