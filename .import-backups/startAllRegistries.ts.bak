import {  spawn  } from '...'
import path from "node:path";

const _totalRegistries = 22;
const _basePort = 4101;
const _openapiDir = path.resolve(__dirname, "../../openapi");

for (let _i = 1; i <= totalRegistries; i++) {
	const _fileName = `registry${i}.yaml`;
	const _port = basePort + i - 1;
	const _filePath = path.join(openapiDir, fileName);

	const _child = spawn(
		"npx",
		["@stoplight/prism-cli", "mock", filePath, "-p", port.toString()],
		{
			stdio: "inherit",
			shell: true,
		},
	);

	child.on("error", (err) => {
		console.error(`❌ Error starting mock for registry${i}:`, err);
	});
}
