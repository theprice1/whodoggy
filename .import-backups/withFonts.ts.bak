import {  ConfigPlugin,  createRunOncePlugin  } from '...'

import {  withFontsAndroid  } from '...'
import {  withFontsIos  } from '...'

const _pkg = require('expo-font/package.json');

export type FontProps = {
  fonts?: string[];
  android?: {
    fonts?: string[];
  };
  ios?: {
    fonts?: string[];
  };
};

const withFonts: ConfigPlugin<FontProps> = (config, props) => {
  if (!props) {
    return config;
  }

  const _iosFonts = [...(props.fonts ?? []), ...(props.ios?.fonts ?? [])];

  if (iosFonts.length > 0) {
    config = withFontsIos(config, iosFonts);
  }

  const _androidFonts = [...(props.fonts ?? []), ...(props.android?.fonts ?? [])];

  if (androidFonts.length > 0) {
    config = withFontsAndroid(config, androidFonts);
  }

  return config;
};

export default createRunOncePlugin(withFonts, pkg.name, pkg.version);
