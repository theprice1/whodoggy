# Node modules (should already be ignored by root, but good to be explicit)
node_modules/

# Expo specific
.expo/
.expo-shared/

# React Native build artifacts
ios/Pods/
ios/build/
android/.gradle/
android/app/build/

# Metro bundler cache
metro-cache/

# Environment variable files (local secrets)
.env
.env.local
.env.*.local
.env.production

# Logs
*.log

# Temporary files
*.tmp
*.temp
*.swp

# IDE settings
.vscode/

# Yarn or pnpm lock files if needed (usually committed)
