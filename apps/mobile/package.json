{
  "name": "@whodoggy/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "WhoDoggy? mobile app built with React Native + Expo",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "dev": "expo start",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "biome check .",
    "lint:fix": "biome check . --apply",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .expo dist build node_modules",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-community/cli": "^20.0.0",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.25",
    "axios": "^1.11.0",
    "expo-status-bar": "~1.12.1",
    "firebase": "^11.10.0",
    "lodash": "4.17.21",
    "nativewind": "^2.0.11",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.2",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@expo/webpack-config": "19.0.1",
    "@types/firebase": "^3.2.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.2.1",
    "@types/react": "^18.2.79",
    "biome": "^0.3.3",
    "expo": "^51.0.39",
    "jest": "^29.7.0",
    "jest-expo": "^51.0.4",
    "rimraf": "^6.0.1",
    "tailwindcss": "4.1.11",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}