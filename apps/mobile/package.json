{
  "name": "@whodoggy/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "echo Mobile export skipped - run pnpm --filter @whodoggy/mobile export:web to build the mobile app",
    "export:web": "expo export --platform all --output-dir ./dist",
    "lint": "npx @biomejs/biome lint './src/**/*.{ts,tsx,js,jsx}'",
    "format": "biome format './src/**/*.{ts,tsx,js,jsx}' --write",
    "type-check": "tsc --noEmit",
    "type-check:build": "tsc --build",
    "clean": "rimraf .expo dist node_modules/.cache",
    "clean:workspace": "pnpm -r run clean",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.25",
    "@react-navigation/stack": "^7.4.8",
    "@whodoggy/shared": "workspace:*",
    "expo": "51.0.28",
    "expo-barcode-scanner": "^13.0.1",
    "expo-constants": "~16.0.2",
    "expo-font": "~12.0.10",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.24",
    "expo-splash-screen": "~0.27.7",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.7",
    "expo-web-browser": "~13.0.3",
    "firebase": "^11.10.0",
    "nativewind": "^4.1.23",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.2",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "4.15.4",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@biomejs/biome": "^1.9.4",
    "@expo/metro-config": "0.17.5",
    "@react-native/babel-preset": "^0.81.1",
    "@types/node": "^24.3.1",
    "@types/react": "18.2.79",
    "@types/react-native": "0.73.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitejs/plugin-react": "^5.0.1",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^7.1.2",
    "eslint-plugin-react-native": "^5.0.0",
    "typescript": "^5.3.3",
    "vitest": "3.2.4"
  }
}