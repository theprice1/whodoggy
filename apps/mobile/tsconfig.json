{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx", // use react-jsx for new React/React Native projects
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "incremental": true,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "target": "ES2020",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "react", "react-native", "jest"],
    "baseUrl": "src",
    "paths": {
      "@whodoggy/shared": ["../../packages/shared/dist"],
      "@whodoggy/shared/*": ["../../packages/shared/dist/*"],
      "@whodoggy/api-client": ["../../packages/api-client/dist"],
      "@whodoggy/api-client/*": ["../../packages/api-client/dist/*"]
    },
    "resolveJsonModule": true,
    "allowJs": false
  },
  "include": ["src/**/*", "src/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "references": [
    {
      "path": "../../packages/shared"
    },
    {
      "path": "../../packages/api-client"
    }
  ]
}
