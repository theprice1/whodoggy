{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "composite": true,
    "noEmit": false,
    "allowJs": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@whodoggy/shared/*": [
        "../../packages/shared/src/*"
      ],
      "@whodoggy/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@whodoggy/api-client/*": [
        "../../packages/api-client/src/*"
      ],
      "@whodoggy/api-client": [
        "../../packages/api-client/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "app/**/*",
    "App.tsx",
    "index.tsx",
    "./global.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".expo",
    "**/*.test.*",
    "**/*.spec.*"
  ],
  "references": [
    {
      "path": "../../packages/shared"
    },
    {
      "path": "../../packages/api-client"
    }
  ]
}
