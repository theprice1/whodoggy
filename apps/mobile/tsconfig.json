{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "incremental": true,
    "types": [
      "node",
      "react",
      "react-native",
      "jest"
    ]
  },
  "include": [
    "src/**/*",
    "src/**/*.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}