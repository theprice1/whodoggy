{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": true,
    "baseUrl": ".",
    "types": ["node", "vitest"],
    "paths": {
      "@whodoggy/shared/*": ["../../packages/shared/*"]
    }
  },
  "include": [
    "src/**/*",
    "app.d.ts",
    "**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
