{
  "name": "whodoggy-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "node dist/server.js",
    "lint": "pnpm exec biome lint .",
    "lint:fix": "pnpm exec biome lint --apply",
    "test": "vitest run --environment jsdom",
    "test:watch": "vitest --watch --environment jsdom",
    "format": "pnpm exec biome format --write .",
    "tsc": "tsc --noEmit",
    "analyze": "vite build -- --analyze"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.14.2",
    "tailwindcss": "^4.1.3",
    "@sentry/react": "^7.52.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^4.4.9",
    "vitest": "^0.34.2",
    "@vitest/ui": "^0.34.2",
    "biome": "^0.3.3",
    "eslint-plugin-react": "^7.37.5",
    "postcss": "^8.4.24",
    "autoprefixer": "^10.4.14"
  }
}