{
	"name": "@whodoggy/web",
	"version": "1.0.0",
	"private": true,
	"main": "index.js",
	"type": "module",
	"scripts": {
		"start": "vite",
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "npx @biomejs/biome lint ./src",
		"format": "biome format ./src --write",
		"type-check": "tsc --noEmit",
		"clean": "rimraf dist node_modules/.cache .vite",
		"clean:workspace": "pnpm -r run clean",
		"test": "vitest run",
		"test:watch": "vitest --watch"
	},
	"dependencies": {
		"firebase": "^11.10.0",
		"react": "18.2.0",
		"react-dom": "18.2.0",
		"react-native-web": "^0.21.1",
		"react-router-dom": "^6.15.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/postcss": "^4.1.12",
		"@tailwindcss/typography": "^0.5.16",
		"@types/node": "^24.3.0",
		"@types/react": "18.2.79",
		"@types/react-dom": "18.2.0",
		"@vitejs/plugin-react": "^5.0.1",
		"autoprefixer": "^10.4.21",
		"postcss": "^8.5.6",
		"tailwindcss": "^4.1.12",
		"typescript": "^5.4.8",
		"vite": "^5.0.0",
		"vitest": "^0.34.6"
	}
