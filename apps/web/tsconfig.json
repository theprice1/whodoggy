{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "incremental": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "jest",
      "react",
      "react-dom"
    ],
    "baseUrl": "src",
    "paths": {
      "@whodoggy/shared": [
        "../../packages/shared/dist"
      ],
      "@whodoggy/shared/*": [
        "../../packages/shared/dist/*"
      ],
      "@whodoggy/api-client": [
        "../../packages/api-client/dist"
      ],
      "@whodoggy/api-client/*": [
        "../../packages/api-client/dist/*"
      ]
    },
    "resolveJsonModule": true,
    "allowJs": false
  },
  "include": [
    "src/**/*",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "references": [
    {
      "path": "../../packages/shared"
    },
    {
      "path": "../../packages/api-client"
    }
  ]
}