{
  "$schema": "https://biomejs.dev/schemas/1.6.3/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "quoteStyle": "double",
    "trailingComma": "all"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "files": {
    "ignore": [
      "node_modules",
      "dist",
      "build",
      "coverage",
      "apps/mobile/.expo",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/__tests__/**"
    ]
  },
  "overrides": [
    {
      "files": ["apps/mobile/**"],
      "linter": {
        "enabled": false
      }
    }
  ]
}
