{
  "name": "whodoggy-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm --filter @whodoggy/mobile dev",
    "dev:web": "pnpm run build:shared && pnpm --filter @whodoggy/web dev",
    "start": "pnpm --filter @whodoggy/mobile start",
    "build": "pnpm --filter @whodoggy/mobile build",
    "build:shared": "pnpm --filter @whodoggy/shared rebuild",
    "lint": "pnpm exec biome lint . && pnpm exec eslint .",
    "lint:fix": "pnpm exec biome lint --apply . && pnpm exec eslint apps/web apps/mobile --ext .ts,.tsx,.js,.jsx --fix",
    "lint:staged": "pnpm exec lint-staged",
    "format": "pnpm exec biome format .",
    "format:write": "pnpm exec biome format --write .",
    "test": "pnpm -r run test",
    "clean": "pnpm -r exec rimraf 'apps/*/dist' 'packages/*/dist' node_modules build coverage .turbo",
    "migrate:up": "pnpm --filter @whodoggy/backend run migrate",
    "migrate:down": "pnpm --filter @whodoggy/backend run migrate:down",
    "migrate:reset": "pnpm --filter @whodoggy/backend run migrate:reset",
    "seed": "pnpm --filter @whodoggy/backend run seed-db",
    "upload:firestore": "pnpm --filter @whodoggy/backend run upload:firestore",
    "audit": "pnpm audit",
    "tsc": "tsc --build --noEmit",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@faker-js/faker": "^9.9.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "biome": "^0.3.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^16.3.0",
    "husky": "^8.0.3",
    "jest": "^30.0.5",
    "lint-staged": "^13.3.0",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0"
  },
  "pnpm": {
    "overrides": {
      "lodash": "4.17.21",
      "form-data": "2.5.4",
      "semver": "7.5.2",
      "request": "2.88.2",
      "tough-cookie": "4.1.3",
      "micromatch": "4.0.8",
      "esbuild": "0.25.0",
      "webpack-dev-server": "5.2.1",
      "send": "0.19.0",
      "on-headers": "1.1.0",
      "inquirer": "9.2.7",
      "inquirer-promise": "1.0.0",
      "request-promise": "4.2.6",
      "@expo/webpack-config": "18.1.1",
      "expo-pwa": "0.0.127",
      "@expo/cli": "0.24.20",
      "image-utils": "0.3.0",
      "lint-staged": "13.3.0",
      "tmp": ">=0.2.4"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}