{
  "name": "whodoggy-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm --filter whodoggy-mobile dev",
    "dev:web": "pnpm run build:shared && pnpm --filter whodoggy-web dev",
    "start": "pnpm --filter whodoggy-mobile start",
    "build": "pnpm --filter whodoggy-mobile build",
    "build:shared": "pnpm --filter @whodoggy/shared rebuild",
    "lint": "pnpm exec biome lint .",
    "lint:fix": "pnpm exec biome lint --apply",
    "lint:staged": "pnpm exec lint-staged",
    "format": "pnpm exec biome format .",
    "format:write": "pnpm exec biome format --write .",
    "test": "pnpm -r run test",
    "clean": "pnpm -r exec rimraf dist node_modules build coverage .turbo",
    "migrate:up": "pnpm --filter whodoggy-backend run migrate",
    "migrate:down": "pnpm --filter whodoggy-backend run migrate:down",
    "migrate:reset": "pnpm --filter whodoggy-backend run migrate:reset",
    "seed": "pnpm --filter whodoggy-backend run seed-db",
    "upload:firestore": "pnpm --filter whodoggy-backend run upload:firestore",
    "audit": "pnpm audit",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "biome": "^0.3.3",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0"
  }
}
