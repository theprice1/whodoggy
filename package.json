{
  "name": "whodoggy-root",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/shared/*",
    "scripts"
  ],
  "scripts": {
    "dev": "pnpm --filter whodoggy-mobile dev",
    "start": "pnpm --filter whodoggy-mobile start",
    "build": "pnpm --filter whodoggy-mobile build",
    "test": "pnpm -r test",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "clean": "pnpm -r exec rimraf dist node_modules build coverage",
    "migrate:up": "pnpm --filter whodoggy-backend node-pg-migrate up",
    "migrate:down": "pnpm --filter whodoggy-backend node-pg-migrate down",
    "migrate:reset": "pnpm --filter whodoggy-backend node-pg-migrate reset",
    "seed": "pnpm --filter whodoggy-backend exec tsx ../../scripts/seedDatabase.ts",
    "upload:firestore": "pnpm --filter whodoggy-backend exec tsx ../../scripts/uploadToFirestore.ts"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.27.1",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.8",
    "@types/react-native": "^0.72.8",
    "babel-jest": "^30.0.4",
    "eslint": "^9.30.1",
    "eslint-plugin-prettier": "^5.5.3",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.0.0",
    "react-test-renderer": "^18.2.0",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "@faker-js/faker": "^9.8.0",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "@react-navigation/stack": "^7.4.2",
    "expo-barcode-scanner": "^13.0.1",
    "firebase": "^11.9.1",
    "firebase-admin": "^13.4.0",
    "nativewind": "^4.1.23",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "0.80.1",
    "react-native-gesture-handler": "^2.27.1",
    "react-native-reanimated": "^3.18.0",
    "react-native-safe-area-context": "^5.5.1",
    "react-native-screens": "^4.11.1"
  }
}
