{
  "name": "whodoggy-root",
  "version": "1.0.0",
  "private": true,
  "description": "A monorepo for Whodoggy project containing mobile, web, and backend applications.",
  "author": "Anthony Price",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "lerna run dev --stream --concurrency 4",
    "start": "lerna run start --stream --concurrency 4",
    "build": "lerna run build --stream --concurrency 4",
    "test": "lerna run test --stream --concurrency 4",
    "sync-readme": "node syncReadme.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "prepare": "lerna bootstrap"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.27.1",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.8",
    "@types/react-native": "^0.72.8",
    "babel-jest": "^30.0.4",
    "eslint": "^9.30.1",
    "jsdom": "^26.1.0",
    "lerna": "^4.0.0",
    "prettier": "^3.0.0",
    "react-test-renderer": "^18.2.0",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "@faker-js/faker": "^9.8.0",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "@react-navigation/stack": "^7.4.2",
    "expo-barcode-scanner": "^13.0.1",
    "firebase": "^11.9.1",
    "firebase-admin": "^13.4.0",
    "nativewind": "^4.1.23",
    "react-native-gesture-handler": "^2.27.1",
    "react-native-reanimated": "^3.18.0",
    "react-native-safe-area-context": "^5.5.1",
    "react-native-screens": "^4.11.1"
  }
}
