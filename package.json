{
  "name": "whodoggy-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace mobile dev --stream --concurrency 4",
    "start": "yarn workspace mobile start --stream --concurrency 4",
    "build": "yarn workspace mobile build --stream --concurrency 4",
    "test": "yarn workspaces run test",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "clean": "rimraf node_modules apps/**/node_modules packages/**/node_modules",
    "prepare": "yarn install"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "eslint": "^9.30.1",
    "prettier": "^3.0.0",
    "typescript": "^5.1.6",
    "@babel/preset-typescript": "^7.27.1",
    "babel-jest": "^30.0.4",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.8",
    "@types/react-native": "^0.72.8",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.8.0",
    "react-test-renderer": "^18.2.0"
  },
  "dependencies": {
    "@faker-js/faker": "^9.8.0",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "@react-navigation/stack": "^7.4.2",
    "expo-barcode-scanner": "^13.0.1",
    "firebase": "^11.9.1",
    "firebase-admin": "^13.4.0",
    "nativewind": "^4.1.23",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "0.80.1",
    "react-native-gesture-handler": "^2.27.1",
    "react-native-reanimated": "^3.18.0",
    "react-native-safe-area-context": "^5.5.1",
    "react-native-screens": "^4.11.1"
  },
  "type": "commonjs"
}
