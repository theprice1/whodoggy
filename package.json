{
  "name": "@whodoggy/root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WhoDoggy - Microchip Scanner App Monorepo",
  "author": "WhoDoggy Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=8.15.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm build:shared",
    "dev": "concurrently \"pnpm:dev:*\"",
    "dev:backend": "pnpm --filter @whodoggy/backend dev",
    "dev:web": "pnpm --filter @whodoggy/web dev",
    "dev:mobile": "pnpm --filter @whodoggy/mobile dev",
    "build": "pnpm run build:deps && pnpm run build:apps",
    "build:deps": "pnpm --filter @whodoggy/shared build && pnpm --filter @whodoggy/api-client build",
    "build:apps": "pnpm --filter @whodoggy/backend build && pnpm --filter @whodoggy/web build",
    "build:shared": "pnpm --filter @whodoggy/shared build",
    "build:api-client": "pnpm --filter @whodoggy/api-client build",
    "build:backend": "pnpm --filter @whodoggy/backend build",
    "build:web": "pnpm --filter @whodoggy/web build",
    "build:mobile": "pnpm --filter @whodoggy/mobile build",
    "start:backend": "pnpm --filter @whodoggy/backend start",
    "start:web": "pnpm --filter @whodoggy/web preview",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --build",
    "typecheck:watch": "tsc --build --watch",
    "clean": "pnpm -r clean && rimraf node_modules",
    "clean:all": "pnpm clean && rimraf pnpm-lock.yaml",
    "db:generate": "pnpm --filter @whodoggy/backend db:generate",
    "db:push": "pnpm --filter @whodoggy/backend db:push",
    "db:migrate": "pnpm --filter @whodoggy/backend db:migrate",
    "db:seed": "pnpm --filter @whodoggy/backend db:seed",
    "db:studio": "pnpm --filter @whodoggy/backend db:studio",
    "openapi:generate": "pnpm --filter @whodoggy/openapi generate",
    "openapi:watch": "pnpm --filter @whodoggy/openapi watch",
    "assets:generate": "node scripts/generate-icons.js",
    "assets:optimize": "svgo -f assets/raw/svg -o assets/generated/svg",
    "assets:clean": "rimraf apps/mobile/assets/*.png apps/web/public/favicon.ico",
    "prebuild": "npm run assets:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.3",
    "@react-native-community/eslint-config": "^3.2.0",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "undici": "^6.21.2",
      "esbuild": "^0.25.0"
    }
  }
}
