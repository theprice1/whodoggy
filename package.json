{
  "name": "whodoggy-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts",
    "tools/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm --filter @whodoggy/mobile dev",
    "dev:web": "pnpm run build:web && pnpm --filter @whodoggy/web dev",
    "dev:backend": "pnpm --filter @whodoggy/backend dev",
    "start": "concurrently \"pnpm backend\" \"pnpm web\" \"pnpm mobile\"",
    "backend": "pnpm --filter @whodoggy/backend start",
    "web": "pnpm --filter @whodoggy/web dev",
    "mobile": "pnpm --filter @whodoggy/mobile start",
    "build": "pnpm -r run build",
    "build:shared": "pnpm --filter @whodoggy/shared rebuild",
    "lint": "pnpm -r eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "biome lint --write ./apps ./packages",
    "format:write": "pnpm biome format --write ./apps ./packages",
    "format:check": "pnpm biome check ./apps ./packages",
    "tsc:check": "pnpm -r tsc --noEmit",
    "type-check": "pnpm -r run type-check",
    "test": "pnpm -r vitest run",
    "test:watch": "vitest --watch",
    "check:all": "pnpm run format:check && pnpm run lint && pnpm run tsc:check && pnpm run test",
    "clean": "pnpm -r run clean",
    "clean:workspace": "pnpm -r run clean",
    "migrate:up": "pnpm --filter @whodoggy/backend run migrate",
    "migrate:down": "pnpm --filter @whodoggy/backend run migrate:down",
    "migrate:reset": "pnpm --filter @whodoggy/backend run migrate:reset",
    "seed": "pnpm --filter @whodoggy/backend run seed-db",
    "upload:firestore": "pnpm --filter @whodoggy/backend run upload:firestore",
    "audit": "pnpm audit",
    "tsc": "tsc --build --noEmit",
    "prepare": "husky install",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.34.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "firebase-admin": "^13.4.0",
    "react": "18.2.0",
    "react-native": "0.72.10"
  },
  "pnpm": {
    "overrides": {
      "lodash": "4.17.21",
      "form-data": "2.5.4",
      "semver": "7.5.2",
      "request": "2.88.2",
      "tough-cookie": "4.1.3",
      "micromatch": "4.0.8",
      "esbuild": "0.25.0",
      "webpack-dev-server": "5.2.1",
      "send": "0.19.0",
      "on-headers": "1.1.0",
      "inquirer": "9.2.7",
      "inquirer-promise": "1.0.0",
      "request-promise": "4.2.6",
      "@expo/webpack-config": "18.1.1",
      "expo-pwa": "0.0.127",
      "@expo/cli": "0.24.20",
      "image-utils": "0.3.0",
      "lint-staged": "13.3.0",
      "tmp": ">=0.2.4",
      "@expo/metro-config": "0.17.8"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
