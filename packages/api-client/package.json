    "lint": "pnpm exec biome lint .",
    "format": "pnpm exec biome format --write ."
  },
  "dependencies": {
    "axios": "^1.10.0"
  },
  "devDependencies": {
    "biome": "^0.3.3",
    "rimraf": "^5.0.0",
    "typescript": "^5.8.3",
    "vitest": "^0.34.2",
    "@vitest/ui": "^0.34.2"
  }
}
