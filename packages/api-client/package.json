{
  "name": "@whodoggy/api-client",
  "version": "1.0.0",
  "description": "API client for WhoDoggy backend",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist node_modules/.cache",
    "build": "tsc -b",
    "rebuild": "pnpm run clean && pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "npx @biomejs/biome lint ./src",
    "lint:fix": "pnpm exec biome lint --apply",
    "format": "biome format .src --write .",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@whodoggy/shared": "workspace:*",
    "axios": "^1.11.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.3.0",
    "@vitest/ui": "^0.34.7",
    "biome": "^0.3.3",
    "rimraf": "^5.0.10",
    "typescript": "^5.2.0",
    "vitest": "^0.34.6"
  }
}