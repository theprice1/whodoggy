{
  "name": "@whodoggy/api-client",
  "version": "1.0.0",
  "description": "API client for WhoDoggy backend",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist node_modules/.cache",
    "clean:workspace": "pnpm -r run clean",
    "build": "tsc -b",
    "rebuild": "pnpm run clean && pnpm run build",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "pnpm exec biome lint",
    "lint:fix": "pnpm exec biome lint --apply",
    "format": "pnpm exec biome format --write",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "@whodoggy/shared": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "react-native": ">=0.74.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@biomejs/biome": "^1.9.4",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitest/ui": "^0.34.7",
    "biome": "^0.3.3",
    "rimraf": "^5.0.10",
    "typescript": "^5.2.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  }
}