{
  "name": "@whodoggy/api-client",
  "version": "1.0.0",
  "description": "API client for WhoDoggy backend",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "rebuild": "pnpm run clean && pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "npx @biomejs/biome lint ./src",
    "lint:fix": "pnpm exec biome lint --apply",
    "format": "pnpm exec biome format --write .",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@whodoggy/shared": "workspace:*",
    "axios": "^1.11.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@types/react-native": "0.73.0",
    "@vitest/ui": "^0.34.7",
    "biome": "^0.3.3",
    "rimraf": "^5.0.10",
    "typescript": "^5.9.2",
    "vitest": "^0.34.6"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}
