{
	"name": "@whodoggy/api-client",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsc",
		"build:watch": "tsup --watch",
		"dev": "tsup --watch",
		"clean": "rimraf dist node_modules/.cache",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "echo \"No tests yet\"",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@whodoggy/shared": "workspace:*",
		"axios": "^1.7.8"
	},
	"devDependencies": {
		"@types/node": "^20.19.13",
		"rimraf": "^5.0.10",
		"tsup": "^8.3.5",
		"typescript": "^5.9.2",
		"vitest": "^2.1.0"
	}
}
