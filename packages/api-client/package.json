{
  "name": "@whodoggy/api-client",
  "version": "1.0.0",
  "description": "API client for WhoDoggy backend",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "rebuild": "pnpm run clean && pnpm run build",
