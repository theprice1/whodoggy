{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "composite": true,
    "incremental": true,
    "moduleSuffixes": [
      ".ts",
      ".js"
    ],
    "paths": {
      "@whodoggy/shared": [
        "../../packages/shared/src",
        "../../packages/shared/dist"
      ],
      "@whodoggy/shared/*": [
        "../../packages/shared/src/*",
        "../../packages/shared/dist/*"
      ]
    },
    "noEmitOnError": true
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    {
      "path": "../../packages/shared"
    }
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}