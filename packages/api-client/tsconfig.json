{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "composite": true,
    "incremental": true,
    "moduleSuffixes": [
      ".ts",
      ".js"
    ],
    "paths": {
      "@whodoggy/shared": [
        "../../packages/shared/src"
      ],
      "@whodoggy/shared/*": [
        "../../packages/shared/src/*"
      ]
    },
    "types": [
      "node",
    ],
    "noEmitOnError": true
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    {
      "path": "../shared"
    }
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}