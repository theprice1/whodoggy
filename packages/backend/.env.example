# .env.example
# PostgreSQL DB connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/whodoggy

# Firebase Admin credentials file path (if loading locally)
FIREBASE_ADMIN_SDK_JSON_PATH=../../secrets/firebase-adminsdk.json

# JWT secret for signing tokens
JWT_SECRET=your-very-secure-secret

# Port the backend server runs on
PORT=3001

# Optional: toggle dev logging
ENABLE_DEBUG_LOGS=true
