{
  "name": "whodoggy-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@faker-js/faker": "^9.8.0",
    "axios": "^1.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "firebase": "^11.9.1",
    "firebase-admin": "^13.4.0",
    "morgan": "^1.10.0",
    "pg": "^8.16.2",
    "rimraf": "^5.0.0"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.17",
    "@types/morgan": "^1.9.3",
    "@types/node": "^20.4.2",
    "@types/pg": "^8.15.4",
    "eslint": "^8.46.0",
    "jest": "^29.6.1",
    "prettier": "^3.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
