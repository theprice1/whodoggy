{
  "name": "whodoggy-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "dev": "dotenv -e ../../.env -- nodemon --watch src --ext ts --exec node --loader ts-node/esm src/index.ts",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,json}'",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,json}'",
    "seed-db": "ts-node-esm scripts/seedDatabase.ts",
    "generate-mock-data": "ts-node-esm scripts/generateMockData.ts",
    "migrate": "dotenv -e ../../.env -- node-pg-migrate up -m src/migrations",
    "migrate:down": "dotenv -e ../../.env -- node-pg-migrate down -m src/migrations",
    "migrate:status": "dotenv -e ../../.env -- node-pg-migrate status -m src/migrations",
    "postinstall": "pnpm run migrate"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@sentry/node": "^9.40.0",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.1",
    "firebase": "^11.9.1",
    "firebase-admin": "^13.4.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.16.3",
    "rimraf": "^5.0.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.3",
    "@types/node": "^20.19.4",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-prettier": "^4.2.5",
    "jest": "^29.7.0",
    "node-pg-migrate": "^8.0.3",
    "nodemon": "^3.0.2",
    "prettier": "^3.6.2",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "node-pg-migrate": {
    "migrations-dir": "./src/migrations",
    "migrations-language": "esm"
  }
}
