{
  "name": "@whodoggy/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf dist node_modules/.cache",
    "clean:workspace": "pnpm -r run clean",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "npx @biomejs/biome lint ./src",
    "lint:fix": "pnpm exec biome lint --apply ./src",
    "format": "@biomejs/biome format ./src --write",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "db:seed": "tsx src/prisma/seed.ts",
    "generate-mock-data": "tsx scripts/generateMockData",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset --force",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "migrate:reset": "prisma migrate reset",
    "upload:firestore": "tsx scripts/uploadToFirestore",
    "fetchDogs": "tsx src/examples/fetchDogs"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@prisma/client": "^6.14.0",
    "@sentry/node": "^9.45.0",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "dotenv-safe": "^9.1.0",
    "express": "^5.1.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.4.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.11",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitest/ui": "^3.2.4",
    "dotenv-cli": "^7.0.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.14.0",
    "rimraf": "^5.0.10",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  }
}