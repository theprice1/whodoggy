{
  "name": "@whodoggy/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf dist node_modules/.cache",
    "clean:workspace": "pnpm -r run clean",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "dev": "ts-node-dev src/index.ts",
    "lint": "npx @biomejs/biome lint ./src",
    "lint:fix": "pnpm exec biome lint --apply",
    "format": "biome format ./src --write",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "seed-db": "tsx scripts/seedDatabase",
    "generate-mock-data": "tsx scripts/generateMockData",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=./prisma/schema.prisma",
    "migrate": "dotenv -e ../../.env -- node-pg-migrate up -c ./node-pg-migrate.config.js",
    "migrate:down": "dotenv -e ../../.env -- node-pg-migrate down -m src/migrations",
    "migrate:status": "dotenv -e ../../.env -- node-pg-migrate status -m src/migrations",
    "upload:firestore": "tsx scripts/uploadToFirestore",
    "fetchDogs": "node --loader ts-node/esm src/examples/fetchDogs",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@prisma/client": "^6.14.0",
    "@sentry/node": "^9.45.0",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "dotenv-safe": "^9.1.0",
    "express": "^4.18.2",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.4.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nodemon": "3.1.10",
    "pg": "^8.16.3",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.11",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitest/expect": "^3.2.4",
    "@vitest/ui": "^0.34.7",
    "biome": "^0.3.3",
    "cross-env": "^10.0.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-prettier": "^4.2.5",
    "globals": "^16.3.0",
    "node-pg-migrate": "^8.0.3",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.14.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.4",
    "typescript": "^5.2.0",
    "typescript-eslint": "^8.39.1",
    "vitest": "^0.34.6"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}