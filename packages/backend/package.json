{
  "name": "whodoggy-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && tsc",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "dev": "dotenv -e ../../.env -- nodemon --watch src --ext ts --exec node --loader ts-node/esm src/index",
    "lint": "pnpm exec biome lint .",
    "lint:fix": "pnpm exec biome lint --apply",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "format": "pnpm exec biome format --write 'src/**/*.{ts,tsx,js,json}'",
    "seed-db": "tsx scripts/seedDatabase",
    "generate-mock-data": "tsx scripts/generateMockData",
    "migrate": "dotenv -e ../../.env -- node-pg-migrate up -c ./node-pg-migrate.config.js",
    "migrate:down": "dotenv -e ../../.env -- node-pg-migrate down -m src/migrations",
    "migrate:status": "dotenv -e ../../.env -- node-pg-migrate status -m src/migrations",
    "upload:firestore": "tsx scripts/uploadToFirestore",
    "fetchDogs": "node --loader ts-node/esm src/examples/fetchDogs",
    "tsc": "tsc --noEmit",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@sentry/node": "^9.40.0",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "dotenv-safe": "^9.1.0",
    "express": "^4.18.1",
    "firebase": "^11.9.1",
    "firebase-admin": "^13.4.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.16.3",
    "rimraf": "^5.0.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.19.6",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitest/ui": "^0.34.2",
    "biome": "^0.3.3",
    "dotenv-cli": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-prettier": "^4.2.5",
    "globals": "^16.3.0",
    "node-pg-migrate": "^8.0.3",
    "nodemon": "^3.0.2",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.0",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.1",
    "vitest": "^0.34.2"
  }
}