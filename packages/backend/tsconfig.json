{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext", // ✅ Keep this
    "moduleResolution": "NodeNext", // ✅ Required for Node ESM
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "jest"
    ],
    "paths": {
      "@shared/*": [
        "../../packages/shared/dist/*"
      ]
    },
    "noEmitOnError": true
  },
  "include": [
    "src/**/*",
    "src/**/*.d.ts",
    "src/__tests__/**/*"
  ],
  "references": [
    {
      "path": "../shared"
    }
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}