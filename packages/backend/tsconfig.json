{
  "compilerOptions": {
    "target": "ES2020",                          // modern JS target
    "module": "CommonJS",                        // Node.js default
    "rootDir": "./src",                          // Point to the source directory
    "outDir": "./dist",                          // compiled JS output
    "types": ["node", "jest", "express"],        // Include relevant types
    "strict": true,                              // enable strict typing
    "esModuleInterop": true,                     // allow import of commonjs modules
    "skipLibCheck": true,                        // speed up compilation
    "forceConsistentCasingInFileNames": true     // consistent file name casing
  },
  "include": [
    "src/**/*.ts",                               // Include all TypeScript files under src
    "src/scripts/**/*.ts"                            // Include all TypeScript files under scripts
  ],
  "exclude": [
    "node_modules",                              // Exclude node_modules folder
    "dist"                                       // Exclude dist folder
  ]
}
