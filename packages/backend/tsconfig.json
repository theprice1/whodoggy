{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,       // Enables importing '.ts' files with extension
    "target": "ES2020",
    "module": "NodeNext",                      // Required for ESM with .ts extensions
    "moduleResolution": "NodeNext",            // Matches 'module' for correct resolution
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./src",
    "paths": {
      "@shared/*": ["../../shared/*"]
    },
    "types": ["node", "jest", "express", "pg-promise", "@faker-js/faker"]
  },
  "include": ["src/**/*.ts", "src/scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
