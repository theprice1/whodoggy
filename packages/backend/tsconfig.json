{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./src",
    "paths": {
      "@shared/*": ["../../shared/*"],
      "@services/*": ["services/*"],
      "@controllers/*": ["controllers/*"]
    },
    "types": ["node", "jest", "express", "pg-promise", "@faker-js/faker"]
  },
  "include": [
    "src/**/*.ts",
    "src/scripts/**/*.ts",
    "src/config/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
