{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": [
      "node",
      "jest"
    ],
    "composite": true,
    "incremental": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": [
    "src/**/*",
    "src/**/*.d.ts",
    "src",
    "src/__tests__"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
