{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,      // Allows importing .ts extensions (if needed)
    "target": "ES2020",
    "module": "NodeNext",                        // Enables ES Modules
    "moduleResolution": "NodeNext",              // Resolves modules like Node ESM
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./src",
    "paths": {
      "@shared/*": ["../../shared/*"],           // Shared types/utilities across workspaces
      "@services/*": ["services/*"],             // Optional: alias for service files
      "@controllers/*": ["controllers/*"]        // Optional: alias for controller files
    },
    "types": ["node", "jest", "express", "pg-promise", "@faker-js/faker"]
  },
  "include": ["src/**/*.ts", "src/scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
