{
  "name": "@whodoggy/scripts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist node_modules/.cache",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/seed/index.ts",
    "seed:dogs": "tsx src/seed/seedDogs.ts",
    "seed:owners": "tsx src/seed/seedOwners.ts",
    "seed:registries": "tsx src/seed/seedRegistries.ts",
    "upload:firestore": "tsx src/uploadToFirestore.ts",
    "cleanup:db": "tsx src/cleanupDatabase.ts",
    "query:registries": "tsx src/queryAllRegistries.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^9.2.0",
    "@whodoggy/backend": "workspace:*",
    "@whodoggy/shared": "workspace:*",
    "axios": "^1.7.8",
    "dotenv": "^16.4.5",
    "firebase-admin": "^12.7.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.10",
    "rimraf": "^5.0.10",
    "tsx": "^4.20.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
