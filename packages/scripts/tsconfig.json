{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "es2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "declaration": true,
    "composite": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "incremental": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "baseUrl": ".",
    "paths": {
      "@whodoggy/shared/*": [
        "../shared/src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "tests"
  ]
}
