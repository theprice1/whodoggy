{
  "name": "@whodoggy/shared",
  "version": "1.0.0",
  "description": "Shared types, interfaces, and utilities for the WhoDoggy project",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist node_modules/.cache",
    "clean:workspace": "pnpm -r run clean",
    "lint": "npx @biomejs/biome lint ./src",
    "format": "npx @biomejs/biome format ./src --write",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run type-check",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "tsc": "tsc --build"
  },
  "dependencies": {
    "firebase": "^11.10.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "^0.74.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.3.0",
    "@types/react": "^18.2.79",
    "@types/react-native": "^0.73.0",
    "rimraf": "^5.0.10",
    "typescript": "^5.2.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "whodoggy",
    "shared",
    "typescript",
    "types",
    "utilities"
  ],
  "author": "WhoDoggy Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "homepage": "https://github.com/your-org/whodoggy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/whodoggy.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/whodoggy/issues"
  }
}