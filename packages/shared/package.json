{
  "name": "@whodoggy/shared",
  "version": "1.0.0",
  "description": "Shared types and utilities for the WhoDoggy project",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist",
    "lint": "npx @biomejs/biome lint ./src",
    "format": "biome format ./src --write",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "react": "18.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/react": "18.2.79",
    "@types/react-native": "0.73.0",
    "rimraf": "^5.0.10",
    "typescript": "^5.4.8"
  },
  "keywords": [
    "whodoggy",
    "shared",
    "typescript",
    "utilities",
    "types"
  ],
  "author": "",
  "license": "MIT"
}