{
	"name": "@whodoggy/shared",
	"version": "1.0.0",
	"description": "Shared types and utilities for the WhoDoggy project",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -b",
		"clean": "rimraf dist node_modules/.cache",
		"clean:workspace": "pnpm -r run clean",
		"lint": "npx @biomejs/biome lint ./src",
		"format": "biome format ./src --write",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest --watch"
	},
	"dependencies": {
		"@expo/metro-config": "0.17.5",
		"expo": "51.0.28",
		"firebase": "^11.10.0",
		"nativewind": "^4.1.23",
		"react": "18.2.0",
		"react-dom": "18.2.0",
		"react-native": "0.74.5",
		"tailwindcss": "^4.1.12"
	},
	"devDependencies": {
		"@babel/core": "^7.24.0",
		"@babel/preset-env": "^7.24.0",
		"@biomejs/biome": "^1.9.4",
		"@react-native/babel-preset": "^0.81.1",
		"@types/node": "^24.3.0",
		"@types/react": "18.2.79",
		"@types/react-native": "0.73.0",
		"rimraf": "^5.0.10",
		"typescript": "^5.2.0",
		"vitest": "^3.2.4"
	},
	"keywords": [
		"whodoggy",
		"shared",
		"typescript",
		"utilities",
		"types"
	],
	"author": "",
	"license": "MIT"
}
