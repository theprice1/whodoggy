{
  "name": "@whodoggy/shared",
  "version": "1.0.0",
  "description": "Shared types and utilities for the WhoDoggy project",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "biome check ./src",
    "format": "biome format ./src --write",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/react": "^18.3.23",
    "@types/react-native": "^0.73.0",
    "rimraf": "^5.0.10",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "whodoggy",
    "shared",
    "typescript",
    "utilities",
    "types"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "firebase": "^11.10.0"
  }
}
