{
  "name": "@whodoggy/shared",
  "version": "1.0.0",
  "description": "Shared types and utilities for WhoDoggy",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./firebase/firebaseAdmin": {
      "types": "./dist/firebase/firebaseAdmin.d",
      "default": "./dist/firebase/firebaseAdmin.js"
    },
    "./firebase/firebaseClient": {
      "types": "./dist/firebase/firebaseClient.d",
      "default": "./dist/firebase/firebaseClient.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "rebuild": "pnpm run clean && pnpm run build",
    "tsc": "tsc --noEmit",
    "watch": "tsc -p tsconfig.json --watch"
  },
  "keywords": [
    "shared",
    "types",
    "firebase",
    "whodoggy"
  ],
  "author": "WhoDoggy Team",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/firebase": "^3.2.3",
    "rimraf": "^5.0.10",
    "typescript": "^5.8.3"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  },
  "dependencies": {
    "firebase": "^11.10.0"
  }
}