{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": [
      "node",
      "jest",
      "react",
      "react-native"
    ],
    "paths": {
      "@whodoggy/shared/*": [
        "../../packages/shared/src/*"
      ]
    },
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "target": "ES2020",
    "esModuleInterop": true,
    "allowJs": false, // keep false to avoid old .js in src
    "resolveJsonModule": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "composite": true,
    "incremental": true,
    "isolatedModules": false, // ensures correct NodeNext compilation
    "noEmitOnError": true // prevents generating broken output
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.js", // exclude old .js files in src
    "**/*.js.map"
  ]
}