{
	"name": "@whodoggy/openapi",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"generate": "openapi-typescript ../../docs/specs/registry-api.yaml --output ../../packages/shared/src/types/openapi.ts",
		"watch": "nodemon --watch ../../docs/specs/registry-api.yaml --exec \"pnpm run generate\"",
		"clean": "rimraf node_modules/.cache",
		"lint": "biome check .",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"nodemon": "^3.1.9",
		"openapi-typescript": "^7.9.3",
		"rimraf": "^5.0.10",
		"typescript": "^5.6.3"
	}
}
