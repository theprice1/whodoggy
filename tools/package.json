{
  "name": "whodoggy-tools",
  "version": "1.0.0",
  "description": "Utility scripts and tooling for the WhoDoggy project (Firebase sync, OpenAPI generation, etc.)",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "scripts",
    "openapi"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist node_modules/.cache",
    "clean:workspace": "pnpm -r run clean",
    "start:scripts": "ts-node scripts/sync-firebase-postgres.ts",
    "start:openapi": "npm run --prefix openapi generate",
    "lint": "npx @biomejs/biome lint ./src ./scripts",
    "format": "npx @biomejs/biome format ./src ./scripts --write",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "prepublishOnly": "pnpm run build && pnpm run type-check"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "firebase-admin": "^13.4.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "ts-node": "^10.9.1",
    "typescript": "^5.8.3",
    "@biomejs/biome": "^1.9.4",
    "vitest": "^3.2.4",
    "rimraf": "^5.0.10"
  },
  "keywords": [
    "whodoggy",
    "tools",
    "scripts",
    "typescript",
    "utilities"
  ],
  "author": "WhoDoggy Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/whodoggy.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/whodoggy/issues"
  },
  "homepage": "https://github.com/your-org/whodoggy"
}