{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": false, // Disabled to avoid JS/TS mix issues in a TS project
    "allowSyntheticDefaultImports": true,
    "isolatedModules": false, // Set false for Node project references (only true for React/JSX)
    "noEmit": false, // Allow compilation for project references
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@whodoggy/shared/*": [
        "packages/shared/dist/*"
      ],
      "@whodoggy/shared": [
        "packages/shared/dist"
      ],
      "@whodoggy/api-client/*": [
        "packages/api-client/dist/*"
      ],
      "@whodoggy/api-client": [
        "packages/api-client/dist"
      ]
    },
    "types": [
      "node"
    ],
    "composite": true,
    "incremental": true
  },
  "include": [
    "packages/**/*",
    "apps/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}