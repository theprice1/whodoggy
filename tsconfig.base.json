{
  "compilerOptions": {
    "target": "ES2020",                     // Modern JS features
    "module": "ESNext",                     // Use ES modules
    "lib": ["ESNext", "DOM"],               // Include DOM types (for React Native/web)
    "allowJs": true,                        // Allow JS files if any
    "skipLibCheck": true,                   // Skip type checking for dependencies
    "strict": true,                        // Enable all strict type checks
    "moduleResolution": "node",             // Node-style module resolution
    "esModuleInterop": true,                // CommonJS interop
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,              // Allow importing JSON files
    "isolatedModules": true,                // Support isolated modules (React Native requirement)
    "noEmit": true                         // Don't emit output, only type check (usually base config)
  }
}
