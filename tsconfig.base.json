{
  "compilerOptions": {
    /* Target modern Node/React output */
    "target": "ES2020",
    /* ESM with pnpm monorepo support */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    /* Strictness + compatibility */
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    /* Project references */
    "composite": true,
    "incremental": true,
    /* Build output */
    "noEmit": false,
    /* React */
    "jsx": "react-jsx",
    /* Avoid JS/TS mixing */
    "allowJs": false,
    /* Module aliases */
    "baseUrl": ".",
    "paths": {
      "@whodoggy/shared/*": [
        "packages/shared/src/*"
      ],
      "@whodoggy/shared": [
        "packages/shared/src"
      ],
      "@whodoggy/api-client/*": [
        "packages/api-client/src/*"
      ],
      "@whodoggy/api-client": [
        "packages/api-client/src"
      ]
    },
    /* Type roots */
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/**/*",
    "apps/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
