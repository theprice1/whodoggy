{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",              // keep ES modules
    "lib": ["ESNext", "DOM"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "NodeNext", // switch from "node" to "NodeNext"
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true // add this to enable .js imports in .ts files
  }
}
