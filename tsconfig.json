{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "rootDir": ".",             // <-- change this from "./src" to "."
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "backend/**/*.ts",
    "scripts/**/*.ts",
    "*.ts"                      // Include .ts files at root like server.ts, prism-runner.ts
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
