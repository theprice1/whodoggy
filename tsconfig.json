{
  "files": [],
  "references": [
    {
      "path": "./apps/mobile"
    },
    {
      "path": "./apps/web"
    },
    {
      "path": "./packages/backend"
    },
    {
      "path": "./packages/shared"
    }
  ],
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "noEmit": true,
    "strict": true,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "target": "ES2020",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".", // Add this to enable path mapping
    "paths": {
      "@whodoggy/shared/*": [
        "packages/shared/src/*"
      ]
    }
  }
}
